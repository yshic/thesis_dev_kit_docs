      </memberdef>
      <memberdef kind="function" id="utility_8h_1ae035ab017746978f2bc4555ec5c8b86d" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int compareVersion</definition>
        <argsstring>(String v1, String v2)</argsstring>
        <name>compareVersion</name>
        <param>
          <type>String</type>
          <declname>v1</declname>
        </param>
        <param>
          <type>String</type>
          <declname>v2</declname>
        </param>
        <briefdescription>
<para>Compares two firmware version strings. </para>
        </briefdescription>
        <detaileddescription>
<para>This function compares two version strings (e.g., &quot;1.0&quot;, &quot;0.9.3&quot;, &quot;2&quot;) by parsing up to three levels of semantic versioning: major, minor, and patch. Missing segments are treated as zero, allowing flexible comparison of version formats like &quot;0.1&quot;, &quot;0.1.0&quot;, or &quot;1&quot;.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">v1</parametername>
</parameternamelist>
<parameterdescription>
<para>The current firmware version (as a <computeroutput>String</computeroutput>). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">v2</parametername>
</parameternamelist>
<parameterdescription>
<para>The incoming/target firmware version (as a <computeroutput>String</computeroutput>).</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="attention"><para>Version strings should be in numeric dot-separated format. Non-numeric parts are ignored. For example, &quot;1.0a&quot; would parse as &quot;1.0.0&quot;. Only the first three segments are considered.</para>
</simplesect>
<simplesect kind="return"><para><itemizedlist>
<listitem><para><computeroutput>-1</computeroutput> if <computeroutput>v1</computeroutput> is lower than <computeroutput>v2</computeroutput></para>
</listitem><listitem><para><computeroutput>0</computeroutput> if both versions are equal</para>
</listitem><listitem><para><computeroutput>1</computeroutput> if <computeroutput>v1</computeroutput> is greater than <computeroutput>v2</computeroutput> </para>
</listitem></itemizedlist>
</para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
